{
  "manifest_version": 3,
  "name": "動画一次情報制作・PCブラウザー連携",
  "version": "0.4.0",
  "description": "APIを使わず、ログイン済みのClaude・ChatGPT画面で記事と画像を制作します。",
  "permissions": ["storage", "unlimitedStorage", "scripting", "offscreen"],
  "host_permissions": ["https://claude.ai/*", "https://chatgpt.com/*", "https://www.youtube.com/*", "https://*.oaiusercontent.com/*", "https://app.neilpatel.com/*", "https://analytics.google.com/*", "https://search.google.com/search-console/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    { "matches": ["https://video-primary-article-studio.k-innovationx.workers.dev/*", "http://localhost/*", "http://127.0.0.1/*"], "js": ["studio-bridge.js"] }
  ]
}
